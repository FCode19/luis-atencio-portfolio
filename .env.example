# Copy this file to .env for local use. Never commit the real .env file.
# Gmail requires two-factor authentication and an App Password.
APP_URL="http://portfolio.local"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-sender@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_ENCRYPTION="tls"

CONTACT_EMAIL="luisatencio0419@gmail.com"
CONTACT_FROM_EMAIL="your-sender@gmail.com"
CONTACT_FROM_NAME="Luis Atencio Portfolio"

# Set to 1 only for local tests that must not send a real message.
PORTFOLIO_CONTACT_DRY_RUN="0"
